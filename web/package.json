{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop:dev": "npm run build && set ELECTRON_RUN_AS_NODE=&& electron .",
    "desktop:pack": "npm run build && electron-builder --dir --x64",
    "desktop:dist": "npm run build && electron-builder --win nsis --x64",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "firebase": "^12.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.myassistant.desktop",
    "productName": "My Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../my-assistant-backend",
        "to": "backend",
        "filter": [
          "app/**/*",
          ".venv/**/*",
          "requirements.txt",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.log",
          "!logs.txt"
        ]
      },
      {
        "from": "../../Qwen3.5-2B-Q4_K_M.gguf",
        "to": "models/Qwen3.5-2B-Q4_K_M.gguf"
      },
      {
        "from": "C:/tmp/llama-cpp-test",
        "to": "llama",
        "filter": [
          "*.exe",
          "*.dll"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
